# Holds pgweb2.db and, if PGWEB_SECRET_KEY is empty, an auto-generated secret.key
PGWEB_DATA_DIR=./data
# Optional Fernet key. Prefer setting this from your secret store so the key isn't stored beside the DB.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PGWEB_SECRET_KEY=
# Optional host allowlist (JSON list of fnmatch patterns)
# PGWEB_ALLOWED_HOSTS=["*.rds.amazonaws.com"]
# First admin, created on startup only while there are no users. Remove the password afterwards.
# Or: python -m app.cli create-user you@example.com
# PGWEB_BOOTSTRAP_ADMIN_EMAIL=
# PGWEB_BOOTSTRAP_ADMIN_PASSWORD=
# Login session: absolute lifetime and idle sign-out
# PGWEB_SESSION_TTL_DAYS=7
# PGWEB_SESSION_IDLE_MINUTES=480
# Manual transactions auto-roll back after this much idleness
# PGWEB_TX_IDLE_TIMEOUT_SECONDS=600
# Audit log retention
# PGWEB_AUDIT_RETENTION_DAYS=90
# Set false ONLY for plain-http local dev; the session cookie is Secure by default
# PGWEB_COOKIE_SECURE=false
